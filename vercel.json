{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx -y pnpm@10.15.0 build",
  "installCommand": "npx -y pnpm@10.15.0 install --no-frozen-lockfile",
  "outputDirectory": "public",
  "git": {
    "deploymentEnabled": {
      "work/mobile-home-ui": false,
      "work/*": false
    }
  }
}
