# Public runtime configuration (value is public by design, but injected by Vercel/Neon)
NEON_AUTH_BASE_URL=

# Server-only database connection. Never expose through public/ or client-side code.
DATABASE_URL=

# Server-only BYOK encryption key.
# Generate a fresh 32-byte random key and store the base64 value only in Vercel.
ORACLE_BYOK_ENCRYPTION_KEY=
